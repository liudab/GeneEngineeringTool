{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./out",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "preload/**/*.ts",
    "electron.vite.config.ts",
    "src/shared/i18n/*.json"
  ]
}
